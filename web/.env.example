# Copy to .env.local for local work, and add the same names in Vercel > Settings > Environment Variables.
# With none of these set the app runs in demo mode on sample data.

# Supabase (accounts and saved data). Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Your site's public address, used in confirmation emails. Optional locally.
NEXT_PUBLIC_SITE_URL=

# Encrypts saved PMS credentials. Server only. Generate with:  openssl rand -base64 32
# Keep a copy somewhere safe: if it is lost, saved credentials cannot be decrypted.
CREDENTIALS_ENCRYPTION_KEY=

# Turns on the Ask HostelPulse chatbot. Server only.
ANTHROPIC_API_KEY=
