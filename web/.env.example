# Copy to .env.local for local work, and add the same names in Vercel > Settings > Environment Variables.
# With none of these set the app runs in demo mode on sample data.

# Supabase (accounts and saved data). Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Your site's public address, used in confirmation and unsubscribe emails. Optional locally.
NEXT_PUBLIC_SITE_URL=

# Server only. Bypasses row-level security: used by the nightly rate job and the unsubscribe page. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/rates (16+ characters). Vercel Cron sends it as a bearer token. Generate with: openssl rand -base64 24
CRON_SECRET=

# Signs unsubscribe links in emails (16+ characters). Generate with: openssl rand -base64 24
UNSUBSCRIBE_SECRET=

# Real email sending through Resend. Both are needed; without them emails only go to a visible outbox.
RESEND_API_KEY=
EMAIL_FROM=

# Encrypts saved PMS credentials. Server only. Generate with:  openssl rand -base64 32
# Keep a copy somewhere safe: if it is lost, saved credentials cannot be decrypted.
CREDENTIALS_ENCRYPTION_KEY=

# Turns on the Ask HostelPulse chatbot. Server only.
ANTHROPIC_API_KEY=
